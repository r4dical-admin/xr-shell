{
  "name": "xr-shell",
  "version": "0.1.0",
  "private": true,
  "description": "A head-tracked spatial application shell for XREAL displays",
  "main": "main.js",
  "scripts": {
    "build:input-bridge": "node scripts/build-input-bridge.js",
    "build:themes": "node scripts/build-profile-themes.js",
    "prestart": "npm run build:input-bridge",
    "start": "electron .",
    "capture": "HORIZON_CAPTURE=1 electron .",
    "mcp": "node mcp/server.js",
    "test": "node --test",
    "check": "npm test"
  },
  "devDependencies": {
    "electron": "^44.4.3"
  }
}
