{
  "name": "xr-shell",
  "version": "0.1.0",
  "private": true,
  "description": "A head-tracked spatial application shell for XREAL displays",
  "main": "main.js",
  "scripts": {
    "build:input-bridge": "node scripts/build-input-bridge.js",
    "premake:mac": "npm run build:input-bridge",
    "make:mac": "electron-forge make --platform darwin",
    "prestart": "npm run build:input-bridge",
    "start": "electron .",
    "capture": "HORIZON_CAPTURE=1 electron .",
    "mcp": "node mcp/server.js",
    "test": "node --test",
    "check": "npm test"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-dmg": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2"
  }
}
